{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corelum AI",
  "version": "1.0.1",
  "identifier": "com.corelum.network",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Corelum AI",
        "theme": "Dark",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#101116",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "AI assistance for everyday tasks.",
    "longDescription": "Corelum AI provides a personal AI workspace and an administrator-only Development Studio for reviewed file drops and application releases.",
    "publisher": "Corelum",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Corelum AI",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OUEyRkExQ0E2RjQ3RTkKUldUcFIyL0tvUythUmMyZ2pQZ0pGbVNpR0tNeEZQbnlKeVBWL1RYVDFlaEJqakVubnN6M3ZrRmoK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
